# Backend — copy to apps/api/.env
# PostgreSQL connection string: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://abaya:changeme@localhost:5432/abaya_shop
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long-string-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long-string-here
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
PORT=3001

# Frontend — copy to apps/web/.env
VITE_API_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001

# Outbound email — powers the nightly end-of-day report (Settings → التقرير اليومي بالبريد).
# Leave SMTP_HOST empty to disable sending. Gmail: use an App Password, not the
# account password, and keep 2FA on. Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pure Diamond <shop@example.com>
