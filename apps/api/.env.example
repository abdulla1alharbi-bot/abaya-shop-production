# SQLite — database file is created at apps/api/prisma/dev.db
DATABASE_URL=file:./dev.db

JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long-string-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long-string-here


FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Reverse proxies in front of the API (0 = published directly). Set to 1 once
# TLS terminates in front, so rate limiting sees the real client IP.
TRUST_PROXY=0
PORT=3001

# Outbound email for the nightly end-of-day report. Empty SMTP_HOST = disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
